# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file — only this example file goes in git.

# --- Database: Supabase (free tier Postgres) ---
# Get this from: Supabase project -> Project Settings -> Database -> Connection string (URI)
# It looks like: postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=

# --- Storage: Cloudflare R2 (free up to 10GB) ---
# Get these from: Cloudflare dashboard -> R2 -> Manage R2 API Tokens -> Create API Token
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# The public URL for your bucket. Either:
#  - the free "public development URL" R2 gives you when you enable public
#    access on the bucket (looks like https://pub-xxxxxxxx.r2.dev), or
#  - a custom domain you've connected to the bucket.
R2_PUBLIC_URL=

# --- App settings ---
# Change these to your own values before going live.
ADMIN_PASSWORD=changeme123
# Everyone must sign in to view the catalog. This is the low-privilege
# "viewer" password you share with staff; ADMIN_PASSWORD unlocks add/edit/delete.
VIEWER_PASSWORD=0000
SECRET_KEY=change-this-to-a-long-random-string
